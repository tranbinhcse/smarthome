# Sinh thật bằng scripts/init-secrets.sh (tạo .env, không commit)
HUBD_PIN=
HUBD_MQTT_USER=hubd
HUBD_MQTT_PASS=
TUYA_MQTT_USER=tuya
TUYA_MQTT_PASS=
# Camera Hikvision (README mục Camera). Bật bằng COMPOSE_PROFILES=camera sau khi điền.
# NVR_USER là tài khoản riêng trên đầu ghi, chỉ có quyền xem; mật khẩu chỉ gồm chữ và số.
#COMPOSE_PROFILES=camera
NVR_HOST=
NVR_USER=
NVR_PASS=
HIK_MQTT_USER=hik
HIK_MQTT_PASS=

# Trợ lý giọng nói (README mục Trợ lý)
HUBD_ASSISTANT_TOKEN=
VOICED_MQTT_USER=voiced
VOICED_MQTT_PASS=
ANTHROPIC_API_KEY=
# HTTPS cho micro trên iPad (scripts/tls-selfsigned.sh):
# HUBD_TLS_CERT=/tls/hub.crt
# HUBD_TLS_KEY=/tls/hub.key
