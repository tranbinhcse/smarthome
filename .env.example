# Sinh thật bằng scripts/init-secrets.sh (tạo .env, không commit)
HUBD_PIN=
HUBD_MQTT_USER=hubd
HUBD_MQTT_PASS=
TUYA_MQTT_USER=tuya
TUYA_MQTT_PASS=
# Camera Hikvision (README mục Camera). Bật bằng COMPOSE_PROFILES=camera; đầu ghi nhập trên dashboard (Cài đặt → Camera).
# NVR_* là cách cũ, chỉ dùng khi trang Cài đặt chưa có IP đầu ghi.
#COMPOSE_PROFILES=camera
HUBD_CAMERA_TOKEN=
NVR_HOST=
NVR_USER=
NVR_PASS=
HIK_MQTT_USER=hik
HIK_MQTT_PASS=

# Trợ lý giọng nói (README mục Trợ lý)
HUBD_ASSISTANT_TOKEN=
VOICED_MQTT_USER=voiced
VOICED_MQTT_PASS=
# AI (URL, khoá, model): nhập ở trang Cài đặt → Trợ lý AI, lưu trong hubd, không để ở đây.
# HTTPS: bật ở trang Cài đặt → HTTPS. Chỉ điền hai dòng dưới nếu dùng chứng chỉ riêng (scripts/tls-selfsigned.sh, tên miền thật):
# HUBD_TLS_CERT=/tls/hub.crt
# HUBD_TLS_KEY=/tls/hub.key
